# Production default for Render/OpenRouter
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional OpenRouter attribution
OPENROUTER_SITE_URL=https://your-frontend.example.com
OPENROUTER_APP_NAME=BRAHMA COS

# LLM controls
LLM_TIMEOUT=60
LLM_TEMPERATURE=0

# Local-only fallback if you want Ollama instead
# LLM_MODEL=ollama/llama3.2:3b
# OLLAMA_API_BASE=http://localhost:11434
